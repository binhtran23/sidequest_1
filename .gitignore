.DS_Store

# Python and local tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Local credentials and overrides
.env
.env.*
!.env.example

# Raw game evidence and local services
replays/
evidence/raw/
walkthrough/
.local/mlflow/
mlruns/
benchmark_results.json

# Detailed development documentation stays local until the competition is closed
# and the final submission is complete. Keep runtime settings and source manifests.
.local/notes/
agents/slices/*/notes.md
agents/slices/*/variants/**/*.md
agents/slices/*/variants/**/kaggle-receipt.json
experiments/README.md

# Experiment runs are reviewed locally. Root README contains only a general overview.
experiments/*/
